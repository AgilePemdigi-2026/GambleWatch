# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API deteksi Python (DET-06). Bawaan http://127.0.0.1:8001; port 8000 dipakai Supabase lokal.
# Jalankan: python -m uvicorn detection_engine.api.main:app --port 8001
DETECTION_API_URL=http://127.0.0.1:8001
# Opsional: kunci bersama Next.js <-> API deteksi (isi nilai yang sama di environment API)
# DETECTION_API_KEY=isi-string-acak-panjang

# Kunci service_role, HANYA untuk server Next.js (tanpa awalan NEXT_PUBLIC_, jangan di-commit).
# Dipakai route /api/analyze untuk menyimpan laporan dan bukti; wajib setelah
# supabase-setup/migration_05_laporan_simpan_server.sql dijalankan.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend Python (detection_engine) membaca file .env.local yang sama dan memakai dua
# nilai di atas, jadi tidak perlu diisi lagi. Hanya isi blok ini bila Python perlu
# kredensial berbeda (mis. service_role key, HANYA di server, jangan di frontend):
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=your-service-role-key
