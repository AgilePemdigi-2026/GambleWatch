# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Python (detection_engine) membaca file .env.local yang sama dan memakai dua
# nilai di atas, jadi tidak perlu diisi lagi. Hanya isi blok ini bila Python perlu
# kredensial berbeda (mis. service_role key, HANYA di server, jangan di frontend):
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=your-service-role-key
